<% layout('/layouts/boilerplate') -%>
    <div class="row mt-3">
        <div class="col-8 offset-2">
          <h3>
            <%=listing.title%>
        </h3>
        </div>
  
    <div class="card col-6 offset-2">
         <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
        <p class="card-text">
          <br>
          <%=listing.description%> <br>
        &#8377;<%=listing.price.toLocaleString("en-IN")%><br>
           <%=listing.location%><br>
           <%=listing.country%><br>    

        </p>
        </div>
    </div>

    <br>

<div class="btns">
     <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark">edit</a>
    <br>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
    </form>

   </div>


   <div class="col-8 offset-2 mb-3">
    <hr>
    <h4>leave a Review</h4>
    <form action ="/listings/<%=listing._id%>/reviews" method = "post" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating</label>
            <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range">
        </div>
        <div class="mb-3 mt-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="5" required></textarea>
            <div class="invalid-feedback">please add some content in the comment field</div>
        </div>
        <button class="btn btn-outline-dark"> submit </button>
    </form>
    <hr>
    <h4><b>All Reviews</b></h4>
    <div class="row">

        <%for( review of listing.reviews){%>
            <div class="card" col-5 ms-3 mb-3>
                <div class="card-body">
                    <h5 class="card-title">
                        nandini gupta
                    </h5>
                    <p class="card-text">
                        <%=review.comment%>
                    </p>
                    <p class="card-text">
                         <%=review.rating%> stars
                    </p>
                    <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                        <button class="btn btn-sm-btn-dark">delete</button>
                    </form>
                </div>
            </div>
        <%}%>

    </div>
   </div>
   </div>
